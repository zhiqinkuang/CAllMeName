# CallMeMing backend env template — placeholders only, no real secrets.
# Copy to .env.local for local development. Never commit real values.

# App
APP_BASE_URL=https://callmeming.com
# Suggested staging origin (buy + ops confirm before locking; do not announce as locked):
# https://staging.callmeming.com
CORS_ALLOWED_ORIGINS=https://callmeming.com
# Comma-separated whitelist only — never use *

# Persistence: memory (default local/tests) | supabase
PERSISTENCE_DRIVER=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional anon key for client; server uses service role. RLS blocks anon on business tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rate limit pepper (required in production)
RATE_LIMIT_PEPPER=replace-with-long-random-string

# Waffo Pancake — mock driver needs no keys; real uses @waffo/pancake-ts
WAFFO_DRIVER=mock
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRODUCT_ID=
WAFFO_STORE_ID=
WAFFO_ENV=test
# Webhook public key from Dashboard (Test/Prod). Mock tests use fixtures.
WAFFO_WEBHOOK_PUBLIC_KEY=

# LLM — mock for local; anthropic for production
LLM_DRIVER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Email — mock for local; resend for production
EMAIL_DRIVER=mock
RESEND_API_KEY=
EMAIL_FROM=CallMeMing <hello@mail.callmeming.com>
